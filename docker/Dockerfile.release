# syntax=docker/dockerfile:1
#
# Release runtime image. GoReleaser builds the smartrouter binary via the
# `builds:` block in .goreleaser.yaml and stages every target's binary
# into this Dockerfile's build context under its `dist/` path, via
# `dockers_v2.extra_files`. $TARGETARCH (amd64, arm64) selects this
# platform's directory; the trailing glob absorbs the CPU-variant suffix
# GoReleaser appends (v3, v8.2). Read the extra_files comment in
# .goreleaser.yaml before changing how the binary gets here.
#
# The standalone binary attached to the GitHub Release and the binary
# inside this image are produced by the same `go build` invocation —
# same toolchain, same flags, byte-identical.

ARG RUNNER_IMAGE="gcr.io/distroless/static-debian12:debug"
FROM ${RUNNER_IMAGE}

ARG TARGETARCH
COPY dist/smartrouter_linux_${TARGETARCH}_*/smartrouter /bin/smart-router

ENV HOME=/smart-router
WORKDIR $HOME

# smart router listener
EXPOSE 3360
# metrics
EXPOSE 7779

ENTRYPOINT ["/bin/smart-router"]
